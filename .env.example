# Copie ce fichier en .env.local et remplis les valeurs.
# .env.local n'est jamais envoyé sur GitHub (il est dans .gitignore).

# URL publique du site (sans slash final) — ex. https://kairos.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Bot Telegram (@BotFather) ---
# Token donné par @BotFather après /newbot (format 123456789:AA...)
TELEGRAM_BOT_TOKEN=
# Secret partagé entre Telegram et le site pour protéger le webhook.
# Invente une longue suite de lettres/chiffres (ou génère-la : node -e "console.log(crypto.randomUUID().replaceAll('-',''))")
TELEGRAM_WEBHOOK_SECRET=

# --- Supabase (Project Settings → API Keys) ---
# Project URL, ex. https://abcdefgh.supabase.co
SUPABASE_URL=
# Clé SECRÈTE (sb_secret_... ou ancienne "service_role") — serveur uniquement, ne jamais la partager
SUPABASE_SECRET_KEY=

# --- Page /admin ---
# Mot de passe de la page admin (long et unique, ex. 20+ caractères)
ADMIN_PASSWORD=
